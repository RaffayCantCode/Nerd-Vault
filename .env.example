# =========================================================
# NERDVAULT ENVIRONMENT CONFIGURATION
# 1. Copy this file to ".env.local"
# 2. Fill in your secrets and API keys
# 3. Restart "npm run dev"
# =========================================================

# --- Authentication (NextAuth / Auth.js) ---
AUTH_SECRET="generate-a-long-random-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (Optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloudflare D1 Remote Database (Optional for local Node/Dev) ---
# If provided, local dev will connect directly to your remote Cloudflare D1 database over HTTPS.
# If omitted, local dev falls back to a local SQLite database in .data/nerdvault-dev.sqlite.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""

# --- Media Metadata APIs ---
TMDB_API_KEY=""
RAWG_API_KEY=""
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
TWITCH_APP_ACCESS_TOKEN=""

# --- Email Notifications ---
MAIL_FROM="noreply@nerdvault.site"

# --- Production Deployment (Cloudflare Pages) ---
# In the Cloudflare Pages Dashboard:
# 1. Settings -> Functions -> D1 database bindings:
#    Variable name: DB
#    D1 database: nerdvault-db
# 2. Settings -> Environment Variables:
#    AUTH_SECRET: (same long random secret)
#    AUTH_URL: https://your-domain.pages.dev
#    AUTH_TRUST_HOST: true
#    TMDB_API_KEY, RAWG_API_KEY, IGDB_CLIENT_ID, etc.

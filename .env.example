# TEMPLATE ONLY — Next.js does NOT load this file.
# 1. Copy this file to ".env.local" in the project root
# 2. Fill in real values from Supabase, Google Cloud, TMDB, etc.
# 3. Restart "npm run dev" after saving .env.local

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
AUTH_SECRET="generate-with-node-crypto-randomBytes-32"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
TMDB_API_KEY=""
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
TWITCH_APP_ACCESS_TOKEN=""

# Production (Netlify): set AUTH_URL and NEXTAUTH_URL to https://nerdvault.site
